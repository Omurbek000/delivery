# Файл-пример. Скопируй его в .env и впиши свои значения.
# .env не хранится в git — пароли в безопасности.

# Безопасный ключ Django (на сервере обязательно замени)
SECRET_KEY=django-insecure-zameni-menya

# Отладка: True на локальной машине, False на боевом сервере
DEBUG=True

# Разрешённые хосты через запятую.
# "*" можно только на локальной машине! На сервере укажи свой домен:
# ALLOWED_HOSTS=onigiri.kg,api.onigiri.kg
ALLOWED_HOSTS=127.0.0.1,localhost

# ===== База данных =====
# PostgreSQL: postgres://юзер:пароль@хост:5432/база
# Если строку убрать/оставить пустой — Django работает на sqlite3
DATABASE_URL=postgres://admin:твой-пароль@localhost:5432/delivery
# Пароль для контейнера Postgres в docker-compose.yml (должен совпадать с DATABASE_URL)
POSTGRES_PASSWORD=твой-пароль

# ===== Кэш (Redis) =====
# Общий кэш для AI-ответов и троттлинга (важно при нескольких воркерах gunicorn)
# Пусто — LocMem. Пример: REDIS_URL=redis://localhost:6379/0
REDIS_URL=

# ===== Email-уведомления о новых заказах =====
# Почта-отправитель (с которой Django шлёт письма) и её пароль
EMAIL_HOST=smtp.mail.ru
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_HOST_USER=onigiri@mail.ru
EMAIL_HOST_PASSWORD=твой-пароль-от-ящика

# Кому слать уведомления о новых заказах
ADMIN_EMAIL=admin@onigiri.delivery

# ===== CORS =====
# Разрешённые источники через запятую (для продакшена укажи домен фронта)
CORS_ALLOWED_ORIGINS=https://onigiri.kg,https://www.onigiri.kg

# ===== JWT =====
# access живет 15 минут, refresh 7 дней — менять не нужно

# ===== Логирование =====
# Логи пишутся в logs/delivery.log и в консоль (уровень INFO)

# ===== Платежи (будущее, ШАГ 4) =====
# YOOKASSA_SHOP_ID=123456
# YOOKASSA_SECRET=live_xxx
# YOOKASSA_RETURN_URL=https://onigiri.kg/order/success

# ===== AI — цепочка с автопереключением =====
# Оставь пустым — пропустится, уйдет в fallback (работает без ключей)
# OpenCode — все бесплатные агенты по одному ключу (через запятую)
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://api.opencode.ai/v1
OPENCODE_MODEL=opencode/muse-spark-1.2-contributor-free
OPENCODE_MODELS=opencode/muse-spark-1.2-contributor-free,opencode/llama-3.1-8b-free,opencode/gemma-2-9b-free
# Gemini Flash — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
