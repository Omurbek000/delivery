# Файл-пример. Скопируй его в .env и впиши свои значения.
# .env не хранится в git — пароли в безопасности.

# Безопасный ключ Django (на сервере обязательно замени)
SECRET_KEY=django-insecure-zameni-menya

# Отладка: True на локальной машине, False на боевом сервере
DEBUG=True

# Разрешённые хосты через запятую (на сервере укажи свой домен)
ALLOWED_HOSTS=*

# ===== Email-уведомления о заказах =====
# Почта-отправитель (с которой Django шлёт письма) и её пароль
EMAIL_HOST=smtp.mail.ru
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_HOST_USER=onigiri@mail.ru
EMAIL_HOST_PASSWORD=твой-пароль-от-ящика

# Кому слать уведомления о новых заказах
ADMIN_EMAIL=admin@onigiri.delivery

# ===== CORS =====
# Разрешённые источники через запятую (для продакшена укажи домен фронта)
CORS_ALLOWED_ORIGINS=https://onigiri.kg,https://www.onigiri.kg

# ===== JWT =====
# access живет 15 минут, refresh 7 дней — менять не нужно

# ===== Логирование =====
# Логи пишутся в logs/delivery.log и в консоль (уровень INFO)

# ===== Платежи (будущее, ШАГ 4) =====
# YOOKASSA_SHOP_ID=123456
# YOOKASSA_SECRET=live_xxx
# YOOKASSA_RETURN_URL=https://onigiri.kg/order/success

# ===== AI (будущее, ШАГ 5) =====
# OPENAI_API_KEY=sk-xxx
